{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.cflmy.cn/cflmy/marqdo-view/raw/branch/master/docs/schema/export-overlay-v1.schema.json",
  "title": "View internal renderer result projection v1",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "properties": {
        "project_root_id": {
          "type": "string"
        },
        "document": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\x00-\\x1f]+$"
        },
        "module_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analysis_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lock_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_root_id",
        "document",
        "module_id",
        "source_sha256",
        "analysis_digest",
        "lock_digest"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "included": {
          "const": true
        },
        "core_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "core_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "terminal_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_verified": {
          "const": true
        },
        "trace_status": {
          "enum": [
            "verified",
            "invalid",
            "unavailable",
            "truncated"
          ]
        },
        "result_complete": {
          "type": "boolean"
        },
        "output_complete": {
          "type": "boolean"
        },
        "observation_truncated": {
          "type": "boolean"
        },
        "parameters": {
          "enum": [
            "omitted",
            "included"
          ]
        },
        "mode": {
          "enum": [
            "pure",
            "project"
          ]
        },
        "core_protocol": {
          "type": "object",
          "properties": {
            "analysis": {
              "enum": [
                2,
                3
              ]
            },
            "trace": {
              "const": 2
            },
            "events": {
              "const": 1
            }
          },
          "required": [
            "analysis",
            "trace",
            "events"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "included",
        "core_run_id",
        "core_version",
        "target",
        "status",
        "terminal_at",
        "source_verified",
        "trace_status",
        "result_complete",
        "output_complete",
        "observation_truncated",
        "parameters",
        "mode",
        "core_protocol"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 131072
    },
    "stdout": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 131072
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 131072
    },
    "trace_counts": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "arguments": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 32,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2
      }
    }
  },
  "required": [
    "source",
    "execution",
    "label",
    "value",
    "stdout",
    "stderr",
    "trace_counts",
    "arguments"
  ],
  "additionalProperties": false
}
